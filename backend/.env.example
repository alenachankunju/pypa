# =============================================================================
# PYPA Marking System — backend environment
# Copy to .env and fill in. NEVER commit .env.
# =============================================================================

NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database — Supabase PostgreSQL
#
# Get these from: Supabase Dashboard -> Project Settings -> Database.
#
# Use the SESSION POOLER (port 5432) for local development and migrations, and
# the TRANSACTION POOLER (port 6543) for the deployed serverless functions.
# Transaction pooling does not support prepared statements, so the pool is
# configured accordingly in src/db/pool.ts when PGBOUNCER_TRANSACTION_MODE=true.
#
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# -----------------------------------------------------------------------------
DATABASE_URL=
# Set true when DATABASE_URL points at the port-6543 transaction pooler.
PGBOUNCER_TRANSACTION_MODE=false
DB_POOL_MAX=10
DB_STATEMENT_TIMEOUT_MS=15000

# -----------------------------------------------------------------------------
# Supabase — used for Storage (photos, logos, exports) and Realtime broadcast.
# NOT used for auth: FSD 5.1 requires admin-created accounts only, with no
# self-registration route anywhere in the application (AC-02).
# -----------------------------------------------------------------------------
SUPABASE_URL=https://vphuozmcdwnmpxzsrdwp.supabase.co
# Publishable / anon key — safe to expose, also used by the frontend.
SUPABASE_ANON_KEY=sb_publishable_mGWCuxuanuEVRQPP23Loaw_0yPcxG8g
# Service role key — SERVER ONLY. Never expose to the browser.
# Supabase Dashboard -> Project Settings -> API -> service_role secret.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=pypa

# -----------------------------------------------------------------------------
# Authentication — FSD 3.4, 5.1
# Generate each secret with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ISSUER=pypa-marking-system

# ADM-01-07: session expiry. 12 hours for judges so a device lock does not force
# a re-login mid-event; 2 hours for admins. (FSD 18.2 defaults.)
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TTL_HOURS_JUDGE=12
REFRESH_TTL_HOURS_ADMIN=2

# ADM-01-04: five consecutive failed attempts lock the account for 15 minutes.
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# 11.2: rate limiting on login (10/min/IP) and score submission (60/min/user).
RATE_LIMIT_LOGIN_PER_MIN=10
RATE_LIMIT_SCORE_PER_MIN=60
RATE_LIMIT_GENERAL_PER_MIN=300

# -----------------------------------------------------------------------------
# CORS — 11.2 requires a strict policy. Comma-separated exact origins.
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# -----------------------------------------------------------------------------
# Seeding — the initial Super Admin (FSD 3.1: "seeded at install").
# The account is created with must_change_password = true (ADM-01-05).
# -----------------------------------------------------------------------------
SEED_SUPERADMIN_USERNAME=superadmin
SEED_SUPERADMIN_PASSWORD=
SEED_SUPERADMIN_NAME=System Administrator

# -----------------------------------------------------------------------------
# Uploads — 11.2: files validated by type and size, images re-encoded on upload.
# -----------------------------------------------------------------------------
MAX_UPLOAD_BYTES=5242880
MAX_IMPORT_ROWS=5000
