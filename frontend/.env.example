# PYPA Marking System — frontend environment (Vite)
#
# Vite exposes only variables prefixed VITE_ to the browser bundle. Anything here
# IS PUBLIC — never put the Supabase service_role key in this file.

# Backend API base URL. Leave blank to use the same origin (dev proxy handles it).
VITE_API_BASE_URL=http://localhost:4000

# Supabase — used ONLY for Realtime subscriptions (current performance on stage,
# live scoring progress) and for reading public storage URLs.
# Authentication does NOT use Supabase (FSD 5.1, AC-02).
VITE_SUPABASE_URL=https://vphuozmcdwnmpxzsrdwp.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_mGWCuxuanuEVRQPP23Loaw_0yPcxG8g

VITE_APP_NAME=PYPA Marking System
